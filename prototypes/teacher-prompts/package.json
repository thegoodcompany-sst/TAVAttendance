{
  "name": "tava-teacher-prompts",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun scripts/serve.ts dev",
    "start": "bun scripts/serve.ts start",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config=playwright.screenshots.config.ts && bun scripts/reset.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "pg": "^8.16.3",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.10.1",
    "typescript": "^5",
    "vitest": "^4"
  },
  "type": "module"
}
