// Config.xcconfig.example — Copy to Config.xcconfig and fill in values
// Config.xcconfig is gitignored
// NOTE: `//` starts a comment in .xcconfig, so the URL's slashes must be split
// with an empty `$()` reference (it expands to nothing); do NOT wrap the value
// in quotes. Result resolves to https://your-project.supabase.co
SUPABASE_PROJECT_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here

// Teacher prompts stay OFF in project.yml, including Release/TestFlight.
// Local review: Debug command-line TEACHER_PROMPTS_V2_ENABLED=YES (v2 backend only),
// or DEBUG-only --teacher-prompts-demo for deterministic offline fake data.
// Future paid-team pilot: set TEACHER_PROMPTS_APNS_ENVIRONMENT to the signed
// aps-environment value (development or production). No entitlement is added here.
// See HUMANS.md teacher-prompt pilot before changing capability/host/rollout flags.
